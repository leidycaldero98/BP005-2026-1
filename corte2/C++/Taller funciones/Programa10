#include <iostream>
#include <iomanip>

using namespace std;


float area(float lado);                                       
float area(float base, float altura);                       
float area(float baseMayor, float baseMenor, float altura);  

int main()
{
    
    float ladoCuadrado = 5.0;
    float baseRect = 8.0, alturaRect = 3.0;
    float bMayor = 8.0, bMenor = 4.0, hTrapecio = 5.0;

    
    float resCuadrado, resRectangulo, resTrapecio;

    
    resCuadrado = area(ladoCuadrado);
    resRectangulo = area(baseRect, alturaRect);
    resTrapecio = area(bMayor, bMenor, hTrapecio);

    
    cout << fixed << setprecision(2);
    cout << "Area del cuadrado: " << resCuadrado << endl;
    cout << "Area del rectangulo: " << resRectangulo << endl;
    cout << "Area del trapecio: " << resTrapecio << endl;

    return 0;
}




float area(float lado) {
    return lado * lado;
}


float area(float base, float altura) {
    return base * altura;
}


float area(float baseMayor, float baseMenor, float altura) {
    return ((baseMayor + baseMenor) * altura) / 2.0;
}
