#include <iostream>
#include <iomanip>

using namespace std;

/* Prototipos */
void leerArreglo(int v[], int n);
int sumarArreglo(int v[], int n);
float calcularPromedio(int suma, int n);
void mostrarArreglo(int v[], int n);

int main()
{
    /* Declaracion de variables */
    int numeros[5];
    int suma;
    float promedio;
    int tamano = 5;

    /* Llamadas a funciones */
    leerArreglo(numeros, tamano);

    cout << "Elementos del arreglo:" << endl;
    mostrarArreglo(numeros, tamano);

    suma = sumarArreglo(numeros, tamano);
    promedio = calcularPromedio(suma, tamano);

    /* Presentacion de resultados */
    cout << "\nSuma: " << suma << endl;
    cout << fixed << setprecision(2) << "Promedio: " << promedio << endl;

    return 0;
}

/* Definicion de funciones */
void leerArreglo(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << "Digite el elemento " << i << ": ";
        cin >> v[i];
    }
}

void mostrarArreglo(int v[], int n) {
    for (int i = 0; i < n; i++) {
        cout << v[i] << " ";
    }
    cout << endl;
}

int sumarArreglo(int v[], int n) {
    int acumulador = 0;
    for (int i = 0; i < n; i++) {
        acumulador += v[i];
    }
    return acumulador;
}

float calcularPromedio(int suma, int n) {
    return static_cast<float>(suma) / n;
}
