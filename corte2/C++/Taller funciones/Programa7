#include <iostream>

using namespace std;

/* Prototipos */
void leerMatriz(int m[][3], int filas);
void mostrarMatriz(int m[][3], int filas);
int sumarMatriz(int m[][3], int filas);

int main()
{
    /* Declaracion de variables */
    int matriz[3][3];
    int sumaTotal;

    /* Llamadas a funciones */
    leerMatriz(matriz, 3);

    cout << "Matriz:" << endl;
    mostrarMatriz(matriz, 3);

    sumaTotal = sumarMatriz(matriz, 3);

    /* Presentacion de resultados */
    cout << "Suma total: " << sumaTotal << endl;

    return 0;
}

/* Definicion de funciones */
void leerMatriz(int m[][3], int filas) {
    for (int i = 0; i < filas; i++) {
        for (int j = 0; j < 3; j++) {
            cout << "Digite m[" << i << "][" << j << "]: ";
            cin >> m[i][j];
        }
    }
}

void mostrarMatriz(int m[][3], int filas) {
    for (int i = 0; i < filas; i++) {
        for (int j = 0; j < 3; j++) {
            cout << m[i][j] << " ";
        }
        cout << endl;
    }
}

int sumarMatriz(int m[][3], int filas) {
    int acumulador = 0;
    for (int i = 0; i < filas; i++) {
        for (int j = 0; j < 3; j++) {
            acumulador += m[i][j];
        }
    }
    return acumulador;
}
