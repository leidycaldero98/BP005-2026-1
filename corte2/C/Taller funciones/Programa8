#include <stdio.h>

/* Prototipos */
void leerMatriz(int m[][3], int filas);
int sumarFila(int m[][3], int fila);
void mostrarSumasPorFila(int m[][3], int filas);

int main()
{
    /* Declaracion de variables */
    int matriz[3][3];

    /* Llamadas a funciones */
    leerMatriz(matriz, 3);
    
    printf("\nMatriz:\n");
    // Reutilizamos un bucle simple para mostrarla antes de las sumas
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            printf("%d ", matriz[i][j]);
        }
        printf("\n");
    }

    /* Presentacion de resultados */
    mostrarSumasPorFila(matriz, 3);

    return 0;
}

/* Definicion de funciones */
void leerMatriz(int m[][3], int filas) {
    for (int i = 0; i < filas; i++) {
        for (int j = 0; j < 3; j++) {
            printf("Digite m[%d][%d]: ", i, j);
            scanf("%d", &m[i][j]);
        }
    }
}

int sumarFila(int m[][3], int fila) {
    int suma = 0;
    for (int j = 0; j < 3; j++) {
        suma += m[fila][j];
    }
    return suma;
}

void mostrarSumasPorFila(int m[][3], int filas) {
    for (int i = 0; i < filas; i++) {
        int resultado = sumarFila(m, i);
        printf("Suma fila %d: %d\n", i, resultado);
    }
}
