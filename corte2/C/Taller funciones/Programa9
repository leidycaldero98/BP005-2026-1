#include <stdio.h>


int factorialIterativo(int n);
int factorialRecursivo(int n);

int main()
{
    
    int numero, resIterativo, resRecursivo;

    
    printf("Digite un numero entero no negativo: ");
    scanf("%d", &numero);

    
    if (numero < 0) {
        printf("Error: El numero debe ser no negativo.\n");
    } else {
        
        resIterativo = factorialIterativo(numero);
        resRecursivo = factorialRecursivo(numero);

        
        printf("Factorial iterativo: %d\n", resIterativo);
        printf("Factorial recursivo: %d\n", resRecursivo);
    }

    return 0;
}



int factorialIterativo(int n) {
    int resultado = 1;
    for (int i = 1; i <= n; i++) {
        resultado *= i;
    }
    return resultado;
}

int factorialRecursivo(int n) {
    
    if (n <= 1) {
        return 1;
    }
    
    else {
        return n * factorialRecursivo(n - 1);
    }
}
